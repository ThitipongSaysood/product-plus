{
  "name": "@pp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx src/scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "evaluate": "tsx src/scripts/evaluate-actors.ts",
    "import:dataset": "tsx src/scripts/import-dataset.ts",
    "refresh:trends": "tsx src/scripts/refresh-trends.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "latest",
    "apify-client": "^2.25.0",
    "cookie-parser": "latest",
    "drizzle-orm": "^0.45.3",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "undici": "^8.11.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@pp/contracts": "workspace:*",
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "drizzle-kit": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
