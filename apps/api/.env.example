# Copy to .env and fill in. .env is gitignored; this file is not.

# Unset -> the api falls back to PGlite at <repo>/.pglite (single process only).
# Set    -> node-postgres against a real server; the api and scripts can run at the same time.
# Database omnix_marketing, schema product_plus (created by the first migration).
DATABASE_URL=postgres://omnix:omnix_local_dev@localhost:5433/omnix_marketing

# Encrypts every secret saved from Settings -> System before it is written to the database.
# WITHOUT THIS, tokens such as APIFY_TOKEN are stored in plain text. 32+ random characters.
# Changing it later makes previously saved secrets unreadable — they come back as unset.
SETTINGS_SECRET=

# Only needed once the app is reachable from outside this machine.
# APP_PASSWORD=
# CRON_SECRET=
